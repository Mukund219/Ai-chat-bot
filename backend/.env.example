# Example environment file for Developer Assistant backend
# Copy this file to `.env` and fill in the real values.
# IMPORTANT: Do NOT commit your real `.env` file to version control.

OPENAI_API_KEY=your-openai-api-key-here
MONGODB_URI=mongodb://localhost:27017/

# Hugging Face Inference API token (if you prefer HF instead of OpenAI)
HUGGINGFACE_API_TOKEN=your-hf-api-token-here
HUGGINGFACE_MODEL=google/flan-t5-small

# Example usage (PowerShell):
#   $env:OPENAI_API_KEY = "sk-..."
# Or create `.env` with real values (ensure it's gitignored).
